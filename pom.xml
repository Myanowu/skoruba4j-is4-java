<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.myano.skoruba4j</groupId>
  <artifactId>skoruba4j-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>skoruba4j-is4-java</name>
  <description>Java drop-in runtime for IdentityServer4 + Skoruba databases and /connect clients</description>

  <modules>
    <module>skoruba4j-domain</module>
    <module>skoruba4j-protocol</module>
    <module>skoruba4j-sts</module>
    <module>skoruba4j-admin</module>
    <module>skoruba4j-admin-api</module>
    <module>skoruba4j-console</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <skoruba4j.dist.dir>${maven.multiModuleProjectDirectory}/dist</skoruba4j.dist.dir>
  </properties>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <executions>
            <execution>
              <id>copy-to-dist</id>
              <phase>package</phase>
              <goals>
                <goal>run</goal>
              </goals>
              <configuration>
                <target>
                  <mkdir dir="${skoruba4j.dist.dir}/lib"/>
                  <copy file="${project.build.directory}/${project.build.finalName}.jar"
                        todir="${skoruba4j.dist.dir}/lib"/>
                </target>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
